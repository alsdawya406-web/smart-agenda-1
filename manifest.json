{
  "name": "Smart Agenda Pro",
  "short_name": "Agenda",
  "description": "تطبيق ذكي لتنظيم المواعيد، فحص الأوقات الشاغرة، وتتبع المهام اليومية بكل سهولة واحترافية",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#007bff",
  "lang": "ar",
  "dir": "rtl",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "logo.png",
      "sizes": "192x192 512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "إضافة موعد",
      "short_name": "موعد جديد",
      "description": "الانتقال السريع لتسجيل موعد جديد",
      "url": "./index.html"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+agenda",
      "url": "./index.html?type=%s"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone"
  ], "note_taking": {
    "new_note_url": "./index.html"
  }
}